# Firebase web app config — copy this file to .env.local and fill in the
# values from Firebase Console > Project Settings > General > Your apps > Web app.
# These are safe to expose in client-side code (not secrets); real access
# control is enforced by firestore.rules and Firebase Authentication.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Cloudinary - used for product photo uploads (unsigned upload preset, not a
# secret). Cloudinary Dashboard for cloud name; Settings > Upload > Upload
# presets for the preset name (must be set to "Unsigned").
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Site address without a trailing slash, used in shared links (tracking,
# product links in WhatsApp messages). Optional: defaults to the address the
# site is opened on.
VITE_SITE_URL=

# AI order assistant (Google Gemini). SERVER ONLY - never prefix with VITE_,
# or the key is shipped to the browser. Get a key at aistudio.google.com.
GEMINI_API_KEY=
# Optional model override.
GEMINI_MODEL=

# Analytics (optional). Each loads only when its ID is set.
VITE_GA_ID=
VITE_META_PIXEL_ID=
